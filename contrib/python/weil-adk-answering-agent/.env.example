# projects/.../locations/.../collections/.../dataStores/...
VERTEXAI_DATASTORE_ID=TODO_update_this_value
# gemini_assistant sub-agent
GEMINI_API_DATASTORE_ID=TODO_update_this_value
# Service-account key JSON as a single-line string.
ADK_GCP_SA_KEY=TODO_update_this_value

