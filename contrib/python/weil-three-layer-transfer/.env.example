# Copy to .env and fill in. Plain KEY=value lines only (no quotes or spaces).
# Only variables without a usable default are listed.

# Weilliptic identity registered on WeilChain (looks like weil_<token>).
# The placeholder is rejected at startup; replace it with your own identity.
WEIL_AGENT_IDENTITY=weil_xxxx

# LiteLLM model id the agent runs on.
AGENT_MODEL=openai/gpt-4o

# LLM key (read by LiteLLM for openai/... models).
OPENAI_API_KEY=TODO_update_this_value

# Environment variables extracted by extract-python-environment-variables
AGENT_VERSION=0.1.0  # extracted-by:extract-env-vars; from getenv in app/app_utils/a2a.py
ALLOW_ORIGINS=<TODO: update-this-value>  # extracted-by:extract-env-vars; from getenv in app/fast_api_app.py; source had "" — empty string, please fix source too
APP_URL=http://0.0.0.0:8000  # extracted-by:extract-env-vars; from getenv in app/app_utils/a2a.py
GOOGLE_CLOUD_AGENT_ENGINE_ID=<TODO: update-this-value>  # extracted-by:extract-env-vars; no default in source
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=<TODO: update-this-value>  # extracted-by:extract-env-vars; no default in source
GOOGLE_CLOUD_LOCATION=<TODO: update-this-value>  # extracted-by:extract-env-vars; no default in source
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>  # extracted-by:extract-env-vars; no default in source
INTEGRATION_TEST=<TODO: update-this-value>  # extracted-by:extract-env-vars; no default in source
LOGS_BUCKET_NAME=<TODO: update-this-value>  # extracted-by:extract-env-vars; no default in source
SESSION_SERVICE_URI=<TODO: update-this-value>  # extracted-by:extract-env-vars; no default in source
