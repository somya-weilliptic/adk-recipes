# Every setting a2a_server reads. Copy to .env, fill in your own values, and
# never commit .env.

# ── Wallet (required) ────────────────────────────────────────────────────────
# The agent's Agent Registry API key; Sentinel holds the private key and signs for it.
WEIL_AGENT_KEY=weil_...
# Or a local wallet file instead of the key:
# WEIL_WALLET_FILE=/path/to/wallet.wc

# The Sentinel node. Unset means production, https://sentinel.weilliptic.ai.
SENTINEL_HOST=https://sentinel.weilliptic.ai

# 0 skips TLS certificate checks, for a local development Sentinel only.
# Never set it in production.
# WEIL_TLS_VERIFY=0

# ── Model ────────────────────────────────────────────────────────────────────
# anthropic (default) or openai.
MODEL_PROVIDER=anthropic

# Anthropic, when MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=
# 1 or 0 turns prompt caching on or off (on by default for Anthropic's own API)
# CLAUDE_PROMPT_CACHE=1

# OpenAI, or any OpenAI-compatible server, when MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=
# OPENAI_BASE_URL=http://localhost:8000/v1

# ── This agent ───────────────────────────────────────────────────────────────
# The port it serves on.
PORT=8003
# In a container: listen on all interfaces, and name the address callers use
# in the agent card (they send their calls there).
# WEIL_A2A_BIND=0.0.0.0
# WEIL_A2A_PUBLIC_URL=http://prime:8003/
